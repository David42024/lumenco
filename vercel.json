{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules/**,dist/**,.git/**,src/**,public/**,*.ts,*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}